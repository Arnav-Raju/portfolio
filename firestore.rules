rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidGuestbookMessage(data) {
      return data.keys().hasAll(['text', 'authorName', 'authorId', 'createdAt']) && 
             data.keys().size() == 4 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.authorId is string && data.authorId.size() <= 128 && data.authorId == request.auth.uid &&
             data.createdAt == request.time;
    }
    
    match /guestbook/{messageId} {
      // Anyone can read the guestbook
      allow read: if true;
      
      // Only signed-in users can create a message
      allow create: if isSignedIn() && isValidId(messageId) && isValidGuestbookMessage(incoming());
      
      // No updates or deletes to guestbook messages
      allow update, delete: if false;
    }
  }
}
